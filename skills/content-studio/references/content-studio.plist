<?xml version="1.0" encoding="UTF-8"?>
<!-- 콘텐츠 스튜디오 LaunchAgent — ~/Library/LaunchAgents/ 에 두고 launchctl load.
     ▶ 프로젝트별: Label · run-studio.sh 절대경로 · 로그 경로(__USER__/__PROJECT__)를 실제 값으로 치환할 것.
     원본 키트는 특정 사용자/프로젝트 경로가 하드코딩돼 있었다. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.content-studio</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>/Users/__USER__/Projects/__PROJECT__/studio/run-studio.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/__USER__/.config/content-studio/studio.log</string>
  <key>StandardErrorPath</key><string>/Users/__USER__/.config/content-studio/studio.log</string>
</dict>
</plist>
